# ============================================================
# PFE MAINTENANCE PRÉDICTIVE - Configuration
# ============================================================

# DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/pfe_maintenance
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_SEMANTIC_EMBEDDINGS=false
SQL_ECHO=False
DB_POOL_DISABLED=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# SECURITY
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_HOURS=24
SEED_DEFAULT_USERS=false
SEED_DEMO_OPERATIONAL_DATA=true
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ENGINEER_PASSWORD=
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
STREAMLIT_SESSION_TTL_HOURS=24

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# STREAMLIT
STREAMLIT_PORT=8501
STREAMLIT_SERVER_HEADLESS=false

# AI/ML
GROQ_API_KEY=your-groq-api-key
OPENAI_API_KEY=your-openai-api-key (optionnel)

# LOGGING
LOG_LEVEL=INFO

# ENVIRONMENT
ENVIRONMENT=development
